# Copy to .env (which is git-ignored) and fill in.
# The labeler needs an API key with System One (Jev) access.
JEV_API_KEY=
# The Jev model used for the policy questions.
JEV_MODEL=jev-1.13
# Set only when the key belongs to a gateway other than the Jev API itself,
# for example OpenCode's.
# JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone

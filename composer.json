{
    "name": "vos/label-classifier",
    "description": "Suggests labels for pull requests by answering per-label policy questions against a shared context",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "symfony/console": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/http-client": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Vos\\LabelClassifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vos\\LabelClassifier\\Benchmark\\": "benchmarks/src/Benchmark/",
            "Vos\\LabelClassifier\\Tests\\": "tests/",
            "Vos\\LabelClassifier\\Tests\\Benchmark\\": "benchmarks/tests/Benchmark/"
        }
    },
    "bin": [
        "bin/label-pull-request"
    ],
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
